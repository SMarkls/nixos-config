// -*- mode: jsonc -*-
{
    "layer": "top",
    "position": "bottom",
    "height": 30,
    "spacing": 0,
    "margin-top": 0,
    "margin-bottom": 0,
    "exclusive": true,

    "modules-left": [
        "custom/start",
        "custom/separator",
        "custom/pin-terminal",
        "custom/pin-browser",
        "custom/pin-files",
        "custom/separator"
    ],
    "modules-center": [
        "wlr/taskbar"
    ],
    "modules-right": [
        "tray",
        "hyprland/language",
        "bluetooth",
        "custom/separator-tray",
        "pulseaudio",
        "custom/pipewire",
        "network",
        "battery",
        "clock"
    ],

    "custom/start": {
        "format": " Start",
        "tooltip": false,
        "on-click": "pkill wofi || wofi --show drun"
    },

    "custom/separator": {
        "format": " ",
        "tooltip": false
    },

    "custom/separator-tray": {
        "format": "",
        "tooltip": false
    },

    "custom/pin-terminal": {
        "format": "",
        "tooltip-format": "Terminal",
        "on-click": "alacritty"
    },

    "custom/pin-browser": {
        "format": "",
        "tooltip-format": "Browser",
        "on-click": "zen-browser"
    },

    "custom/pin-files": {
        "format": "",
        "tooltip-format": "Files",
        "on-click": "dolphin"
    },

    "wlr/taskbar": {
        "format": "{icon} {name}",
        "icon-size": 16,
        "tooltip-format": "{title}",
        "on-click": "activate",
        "on-click-middle": "close",
        "on-click-right": "minimize-raise",
        "app_ids-mapping": {}
    },

    "tray": {
        "icon-size": 14,
        "spacing": 4
    },

    "hyprland/language": {
        "format": "{}",
        "format-en": "EN",
        "format-ru": "RU"
    },

    "pulseaudio": {
        "format": " {volume}%",
        "format-muted": " Mute",
        "format-icons": {
            "default": [""]
        },
        "on-click": "pavucontrol"
    },

    "network": {
        "format-wifi": "",
        "format-disconnected": "",
        "tooltip-format": "{essid} | {ipaddr}",
        "on-click": "kitty --class clipse -e nmtui"
    },

    "battery": {
        "format": " {capacity}%",
        "format-charging": " {capacity}%",
        "format-plugged": " {capacity}%",
        "format-icons": [""]
    },

    "bluetooth": {
      "format": "",
      "on-click": "blueman-manager"
    },
    "clock": {
        "format": "{:%H:%M}",
        "format-alt": "{:%d.%m.%Y %H:%M}",
        "tooltip-format": "<tt>{calendar}</tt>"
    }
}
